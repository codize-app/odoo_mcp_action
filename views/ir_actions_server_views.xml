<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_server_action_form_mcp" model="ir.ui.view">
        <field name="name">ir.actions.server.form.mcp</field>
        <field name="model">ir.actions.server</field>
        <field name="inherit_id" ref="base.view_server_action_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="MCP" name="mcp" invisible="state != 'code'">
                    <group>
                        <field name="is_mcp"/>
                        <field name="mcp_route" invisible="not is_mcp" required="is_mcp"/>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
